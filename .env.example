# LLM provider-independent config. Prefer the web console (python -m adonis.web)
# for editing these; changes here need a fresh process (the server picks them
# up automatically on save).

# Which provider adapter to load: "anthropic" | "openai" | "custom"
#   anthropic  Anthropic Messages API
#   openai     OpenAI Chat Completions API
#   custom     Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...)
#              via ADONIS_LLM_BASE_URL; the key may be empty for local inference.
ADONIS_LLM_PROVIDER=anthropic

# API key for the chosen provider.
ADONIS_LLM_API_KEY=

# Optional per-tier overrides (leave blank to use ADONIS_LLM_PROVIDER).
# ADONIS_EXTRACTOR_PROVIDER=
# ADONIS_JUDGE_PROVIDER=

# Two tiers: extractor is cheaper/faster; judge is larger/smarter.
ADONIS_EXTRACTOR_MODEL=claude-3-5-haiku-latest
ADONIS_JUDGE_MODEL=claude-3-5-sonnet-latest

# Optional base URL override. Required for provider "custom":
# example Ollama: http://localhost:11434/v1
# ADONIS_LLM_BASE_URL=

# Embedding model (sentence-transformers identifier).
ADONIS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Candidate generation knobs.
ADONIS_TOP_K=20
ADONIS_TRIVIALITY_CUTOFF=0.3
ADONIS_SPAN_FUZZY_THRESHOLD=90
ADONIS_JUDGE_PER_CLAIM=3
ADONIS_CANDIDATE_ENTITY_WEIGHT=0.3

# Verification (M4): entailment score must reach this to pass.
ADONIS_ENTAIL_MIN_CONFIDENCE=0.8

# Claim extraction (M2).
ADONIS_CHUNK_MAX_CHARS=1200
ADONIS_GLINER_MODEL=urchade/gliner_medium-v2.1
ADONIS_GLINER_THRESHOLD=0.5
ADONIS_CANONICALIZE_FUZZY_THRESHOLD=0.88
# ADONIS_CANONICALIZE_LLM_MERGE=false

# Paths.
ADONIS_DB_PATH=data/db/adonis.sqlite
ADONIS_CORPUS_DIR=data/corpus
ADONIS_REPORTS_DIR=reports
